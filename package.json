{
    "name": "pretzel-cloud",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n control-plane,portal,stripe -c cyan,magenta,yellow \"npm:dev:control-plane\" \"npm:dev:portal\" \"npm:dev:stripe\"",
        "dev:control-plane": "npm run dev --workspace=packages/control-plane",
        "dev:portal": "npm run dev --workspace=packages/portal",
        "migrate": "npm run migrate --workspace=packages/control-plane",
        "typecheck": "tsc -b packages/shared packages/control-plane && npm run typecheck --workspace=packages/portal",
        "dev:stripe": "command -v stripe >/dev/null && stripe listen --forward-to localhost:4000/api/billing/webhook || echo 'stripe CLI not found - billing webhooks will not be delivered locally'",
        "dev:fly": "ENV_FILE=.env.fly npm run dev",
        "release": "bash scripts/release.sh",
        "build": "npm run build --workspaces --if-present",
        "release:local": "bash scripts/release-local.sh"
    },
    "devDependencies": {
        "@types/node": "^25.2.0",
        "concurrently": "^9.2.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
