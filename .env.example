PORT=4000
CORS_ORIGIN=http://portal.dev.localhost:5174
PORTAL_URL=http://portal.dev.localhost:5174
# Where the issuer may redirect back to, for the flows that redirect.
GOTRUE_URI_ALLOW_LIST=http://portal.dev.localhost:5174

# ── Infrastructure (docker compose up -d) ────────────────────────────────────
# Offset from PretzelGraph's stack so both can run at once.
POSTGRES_CLOUD_PORT=5433
POSTGRES_ALPHA_PORT=5434
POSTGRES_BETA_PORT=5435
POSTGRES_PASSWORD=pretzel
GOTRUE_PORT=9998

# ── Control plane ────────────────────────────────────────────────────────────
# Portal database: desired state, RLS scoped by membership.
PORTAL_DATABASE_URL_APP=postgres://portal_app:app@localhost:5433/portal
PORTAL_DATABASE_URL_SERVICE=postgres://portal_service:service@localhost:5433/portal

# Fleet database: connection strings, key material, machines. Service only.
FLEET_DATABASE_URL=postgres://fleet_service:service@localhost:5433/fleet

# The workspace cluster. Provisioning connects here to create workspace databases.

# How clients reach that same cluster — it is not on localhost from inside a
# container.

# Workspace containers are attached to this network as well as their own, so
# `postgres` and `gotrue` resolve for them.
FLEET_INFRA_NETWORK=pretzel-cloud

# ── Fleet issuer ─────────────────────────────────────────────────────────────
# Shared with gotrue, and with every workspace that verifies its tokens.
AUTH_JWT_SECRET=dev-jwt-secret-change-me
GOTRUE_EXTERNAL_URL=http://localhost:9998
# What the portal in a browser uses.
VITE_AUTH_URL=http://localhost:9998
# The parent the session cookie is scoped to, so every workspace hostname sees
# it. Left empty the session stays on whichever host set it.
VITE_SESSION_COOKIE_DOMAIN=dev.localhost
# What a workspace container uses, on the docker network.
WORKSPACE_AUTH_URL=http://gotrue:9999
# What the control plane uses to reach the issuer's admin surface.
AUTH_ADMIN_URL=http://localhost:9998
# Sign in with GitHub. Needs an OAuth app (github.com/settings/developers) whose
# callback URL is GOTRUE_EXTERNAL_URL + /callback. Left off, the button is not shown.
GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
# Who may reach /api/admin. Comma separated; empty means nobody.
OPERATOR_USER_IDS=
# The one workspace whose listings form the extended shelf. Empty means none.
EXTENDED_SHELF_WORKSPACE_ID=
# How many workspaces one account may own. Empty means 1.
MAX_WORKSPACES_PER_OWNER=


# ── Provisioning ─────────────────────────────────────────────────────────────
# docker in dev, fly in production.
MACHINE_DRIVER=docker

# Development only. Absolute path to the PretzelGraph checkout: machines then
# run its built `dist` instead of the copy in their image, so a backend change
# is `npm run build` + a restart rather than a new image. Empty uses the image.
WORKSPACE_DEV_REPO=

WORKSPACE_IMAGE=pretzel-graph-combined:latest

# Workspace hostnames are derived from this.
# Where the router listens. Workspace hostnames carry this port.
FLEET_ROUTER_PORT=8080
FLEET_DOMAIN=dev.localhost:8080

# Billing — per-environment and never committed. Which price sells which plan
# is `plans.stripe_price_id`, set per database rather than here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Fly ──────────────────────────────────────────────────────────────────────
# Read only when MACHINE_DRIVER=fly. The app every workspace machine is created
# in; the token is scoped to it.
FLY_APP=
FLY_API_TOKEN=

# Development only: the editor comes from this origin instead of the machine.
# Unset in production, where each machine serves the bundle built into it.
# The router forwards every request on this host to the API, whatever the path.
# Unset in development, where the API has a port to itself.
CONTROL_PLANE_HOST=


# One per cluster, named after the row in `clusters`. Held here rather than
# beside the row: it reaches every database on that cluster.
CLUSTER_ADMIN_URL_ALPHA=
CLUSTER_ADMIN_URL_BETA=
