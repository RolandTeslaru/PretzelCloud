PORT=4000
CORS_ORIGIN=http://localhost:5174
PORTAL_URL=http://localhost:5174

# ── Infrastructure (docker compose up -d) ────────────────────────────────────
# Offset from PretzelGraph's stack so both can run at once.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=pretzel
GOTRUE_PORT=9998

# ── Control plane ────────────────────────────────────────────────────────────
# Portal database: desired state, RLS scoped by membership.
PORTAL_DATABASE_URL_APP=postgres://portal_app:app@localhost:5433/portal
PORTAL_DATABASE_URL_SERVICE=postgres://portal_service:service@localhost:5433/portal

# Fleet database: connection strings, key material, machines. Service only.
FLEET_DATABASE_URL=postgres://fleet_service:service@localhost:5433/fleet

# The workspace cluster. Provisioning connects here to create workspace databases.
CLUSTER_ADMIN_DATABASE_URL=postgres://postgres:pretzel@localhost:5433/postgres

# How clients reach that same cluster — it is not on localhost from inside a
# container.
CLUSTER_CLIENT_HOST=postgres:5432

# Workspace containers are attached to this network as well as their own, so
# `postgres` and `gotrue` resolve for them.
FLEET_INFRA_NETWORK=pretzel-cloud

# ── Fleet issuer ─────────────────────────────────────────────────────────────
# Shared with gotrue, and with every workspace that verifies its tokens.
AUTH_JWT_SECRET=dev-jwt-secret-change-me
GOTRUE_EXTERNAL_URL=http://localhost:9998
# What a workspace container uses, on the docker network.
WORKSPACE_AUTH_URL=http://gotrue:9999


# ── Provisioning ─────────────────────────────────────────────────────────────
# docker in dev, fly in production.
MACHINE_DRIVER=docker

WORKSPACE_IMAGE=pretzel-graph-combined:latest
WORKSPACE_SIZE=shared-1x-512

# Workspace hostnames are derived from this.
FLEET_DOMAIN=localhost:8080
