PORT=4000
CORS_ORIGIN=http://localhost:5174

# Portal database — desired state, RLS scoped by membership.
PORTAL_DATABASE_URL_APP=postgres://portal_app:app@localhost:5432/portal
PORTAL_DATABASE_URL_SERVICE=postgres://portal_service:service@localhost:5432/portal

# Fleet database — connection strings, key material, machines. Service only.
FLEET_DATABASE_URL=postgres://fleet_service:service@localhost:5432/fleet

# The workspace cluster. Provisioning connects here to create workspace databases.
CLUSTER_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Fleet issuer.
AUTH_URL=http://localhost:9999

# Trusts x-dev-user-id / x-dev-user-email headers. Never set this anywhere reachable.
PORTAL_DEV_AUTH=true

# docker in dev, fly in production.
MACHINE_DRIVER=docker

# The image a workspace machine runs.
WORKSPACE_IMAGE=pretzel-graph-backend:latest
WORKSPACE_SIZE=shared-1x-512

# Workspace hostnames are derived from this.
FLEET_DOMAIN=localhost:8080
