{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "useDefineForClassFields": true,
        "paths": {
            "@/*": ["./src/*"],
            "@pretzel-cloud/shared/*": ["../shared/*"],
            "@pretzel-graph/standard-ui/*": ["../../../PretzelGraph/packages/standard-ui/src/*"],
            "react": ["../../node_modules/@types/react"],
            "react/*": ["../../node_modules/@types/react/*"],
            "react-dom": ["../../node_modules/@types/react-dom"],
            "react-dom/*": ["../../node_modules/@types/react-dom/*"],
            "react-hook-form": ["../../node_modules/react-hook-form"],
            "zustand": ["../../node_modules/zustand"],
            "zustand/*": ["../../node_modules/zustand/*"],
            "immer": ["../../node_modules/immer"],
            "tsyringe": ["../../node_modules/tsyringe"]
        }
    },
    "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
