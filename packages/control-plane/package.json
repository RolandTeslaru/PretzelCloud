{
    "name": "@pretzel-cloud/control-plane",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "test:admin": "ts-node -r tsconfig-paths/register scripts/admin.spec.ts",
        "migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -R migrations dist/control-plane/migrations",
        "start": "node dist/control-plane/src/main.js",
        "typecheck": "tsc --noEmit",
        "dev": "nodemon -w src -e ts,json --exec ts-node -r tsconfig-paths/register src/main.ts",
        "token": "ts-node -r tsconfig-paths/register scripts/token.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.2.1",
        "@nestjs/core": "^11.2.1",
        "@nestjs/platform-express": "^11.2.1",
        "@nestjs/platform-ws": "^11.2.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.2.1",
        "@pretzel-cloud/shared": "*",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-proxy": "^1.18.1",
        "ioredis": "^6.0.0",
        "jose": "^6.2.9",
        "kysely": "^0.28.9",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "stripe": "^22.5.0",
        "ws": "^8.21.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/http-proxy": "^1.17.17",
        "@types/pg": "^8.15.6",
        "@types/ws": "^8.18.1",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.2",
        "tsconfig-paths": "^4.2.0"
    }
}
